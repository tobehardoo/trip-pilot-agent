{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/agent-completed-event-v1.schema.json",
  "title": "Agent Completed Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "schemaVersion",
    "eventId",
    "traceId",
    "tripId",
    "runId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventType": {"const": "AGENT_COMPLETED"},
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "itinerary"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"},
        "itinerary": {"type": "object"},
        "slots": {
          "type": "object",
          "description": "Confirmed-slot projection for the apply flow (name -> {value, state}).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "state"],
            "properties": {
              "value": {},
              "state": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
