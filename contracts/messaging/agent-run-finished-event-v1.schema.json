{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/agent-run-finished-event-v1.schema.json",
  "title": "Agent Run Finished Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "schemaVersion",
    "eventId",
    "traceId",
    "tripId",
    "runId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventType": {"const": "AGENT_RUN_FINISHED"},
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["STOPPED", "FAILED", "EXPIRED", "ANSWERED"]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode", "message"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reasonCode": {"$ref": "#/$defs/reasonCode"},
        "message": {"$ref": "#/$defs/message"}
      }
    }
  }
}
