{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/planning-replan-command-v1.schema.json",
  "title": "Planning Local Replan Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType", "schemaVersion", "eventId", "traceId", "taskId",
    "tripId", "occurredAt", "payload"
  ],
  "properties": {
    "eventType": {"const": "PLANNING_REPLAN_REQUESTED"},
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskType", "baselineTripVersion", "baselineItineraryVersionId",
        "idempotencyKey", "impactedDates", "trip", "itinerary", "knowledge"
      ],
      "properties": {
        "taskType": {"const": "REPLAN"},
        "baselineTripVersion": {"type": "integer", "minimum": 0},
        "baselineItineraryVersionId": {"type": "string", "format": "uuid"},
        "idempotencyKey": {"type": "string", "format": "uuid"},
        "impactedDates": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "trip": {"$ref": "planning-create-command-v2.schema.json#/$defs/trip"},
        "itinerary": {"$ref": "#/$defs/replanItinerary"},
        "knowledge": {
          "$ref": "planning-completed-event-v11.schema.json#/$defs/knowledgeEvidence"
        }
      }
    },
    "replanItinerary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "provider", "days", "estimatedTotalCost"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "provider": {"enum": ["AMAP", "DEMO"]},
        "days": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/replanDay"}},
        "estimatedTotalCost": {"$ref": "planning-completed-event-v11.schema.json#/$defs/money"}
      }
    },
    "replanDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "activities", "transitLegs"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "activities": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "planning-completed-event-v11.schema.json#/$defs/amapActivity"},
              {"$ref": "planning-completed-event-v11.schema.json#/$defs/demoActivity"}
            ]
          }
        },
        "transitLegs": {
          "type": "array", "maxItems": 999,
          "items": {"$ref": "planning-completed-event-v11.schema.json#/$defs/transitLeg"}
        }
      }
    }
  }
}
