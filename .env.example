# Copy this file to .env and fill values locally. Never commit .env.
APP_ENV=local
IMAGE_TAG=local
# Staging/production acceptance must override every runtime image with its
# approved full registry reference and @sha256 digest. Local builds use IMAGE_TAG.
# POSTGRES_IMAGE=registry.example/trip-pilot-postgres@sha256:<64-hex-digest>
# REDIS_IMAGE=redis@sha256:<64-hex-digest>
# RABBITMQ_IMAGE=rabbitmq@sha256:<64-hex-digest>
# TRAVEL_SERVER_IMAGE=registry.example/trip-pilot-travel-server@sha256:<64-hex-digest>
# AGENT_SERVICE_IMAGE=registry.example/trip-pilot-agent-service@sha256:<64-hex-digest>
# WEB_IMAGE=registry.example/trip-pilot-web@sha256:<64-hex-digest>
# PROMETHEUS_IMAGE=prom/prometheus@sha256:<64-hex-digest>
# DEMO_ONLY | REAL_ONLY | REAL_WITH_EXPLICIT_FALLBACK
PROVIDER_MODE=DEMO_ONLY
# Legacy compatibility only. Do not set together with a conflicting PROVIDER_MODE.
# DEMO_MODE=true
TRAVEL_SERVER_PORT=8080
TRAVEL_SERVER_URL=http://localhost:8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY_CIDR=172.30.250.1/32
APP_NETWORK_SUBNET=172.30.250.0/24
APP_NETWORK_GATEWAY=172.30.250.1
PROMETHEUS_PORT=9090

POSTGRES_DB=trip_pilot
POSTGRES_USER=trip_pilot
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432

# Optional knowledge-store DSN override. Leave empty to derive from POSTGRES_*.
KNOWLEDGE_DATABASE_URL=
KNOWLEDGE_EMBEDDING_PROVIDER=demo
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_SOURCE_DIRECTORY=../../knowledge/sources
# Required when KNOWLEDGE_EMBEDDING_PROVIDER=dashscope.
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_TIMEOUT_SECONDS=10

REDIS_PASSWORD=replace-with-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=2

RABBITMQ_USER=trip_pilot
RABBITMQ_PASSWORD=replace-with-local-password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_DELAY_MS=1000
EVENT_CONSUMER_ENABLED=true
CITY_INTELLIGENCE_PLANNING_WAIT_TIMEOUT=PT2S

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
REFRESH_COOKIE_SECURE=true
# Shared only by the private travel-server -> agent-api connection. Use a distinct random value.
AGENT_INTERNAL_TOKEN=replace-with-a-random-internal-token-at-least-32-bytes
# Used only for the protected diagnostics endpoint. Keep this distinct from
# AGENT_INTERNAL_TOKEN and rotate it independently.
INTERNAL_DIAGNOSTICS_TOKEN=replace-with-a-random-diagnostics-token-at-least-32-bytes

AMAP_WEB_SERVICE_KEY=
# Server-only AMap place-search guardrails (never sent to the browser).
PLACES_MAX_RESULTS=8
PLACES_RATE_LIMIT_PER_MINUTE=20
# Server-only QWeather credential for real-time, forecast, and recent historical weather.
QWEATHER_API_KEY=
# Required by QWeather in 2026. Copy the dedicated host from QWeather Console -> Settings.
QWEATHER_API_HOST=
AMAP_TIMEOUT_SECONDS=5
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.2
PROVIDER_RETRY_MAX_DELAY_SECONDS=2
PROVIDER_RETRY_MAX_ELAPSED_SECONDS=5
PROVIDER_RETRY_JITTER_RATIO=0.2
# JSON array. Only QUOTA_EXCEEDED and MALFORMED_RESPONSE are configurable;
# authentication, permission, invalid-request, adapter, and internal failures stay denied.
PROVIDER_FALLBACK_CATEGORIES=[]
POI_CACHE_TTL_SECONDS=86400
# Optional OpenAI-compatible structured-output model used only for evidence-backed
# candidate extraction. Leave all three blank to keep deterministic rules only.
STRUCTURED_MODEL_ENDPOINT=
STRUCTURED_MODEL_API_KEY=
STRUCTURED_MODEL_NAME=
STRUCTURED_MODEL_TIMEOUT_SECONDS=8
STRUCTURED_MODEL_MAX_RETRIES=1
STRUCTURED_MODEL_MAX_INPUT_CHARACTERS=30000
# Browser-visible AMap JS API credentials. Never reuse AMAP_WEB_SERVICE_KEY here.
VITE_AMAP_WEB_JS_KEY=
VITE_AMAP_SECURITY_CODE=

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=qwen
