{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/planning-completed-event-v6.schema.json",
  "title": "Planning Completed Event v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType", "schemaVersion", "eventId", "traceId", "taskId",
    "tripId", "runId", "occurredAt", "payload"
  ],
  "properties": {
    "eventType": {"const": "PLANNING_COMPLETED"},
    "schemaVersion": {"const": 6},
    "eventId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {
      "oneOf": [
        {"$ref": "#/$defs/amapPayload"},
        {"$ref": "#/$defs/demoPayload"}
      ]
    }
  },
  "$defs": {
    "amapPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "itinerary", "knowledge", "factImpacts"],
      "properties": {
        "provider": {"const": "AMAP"},
        "itinerary": {"$ref": "#/$defs/amapItinerary"},
        "knowledge": {"$ref": "#/$defs/knowledgeEvidence"},
        "factImpacts": {"$ref": "#/$defs/factImpacts"},
        "providerProvenance": {"$ref": "#/$defs/providerProvenance"}
      }
    },
    "demoPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "itinerary", "knowledge", "factImpacts"],
      "properties": {
        "provider": {"const": "DEMO"},
        "itinerary": {"$ref": "#/$defs/demoItinerary"},
        "knowledge": {"$ref": "#/$defs/knowledgeEvidence"},
        "factImpacts": {"$ref": "#/$defs/factImpacts"},
        "providerProvenance": {"$ref": "#/$defs/providerProvenance"}
      }
    },
    "factImpacts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId", "category", "effect", "reason", "sourceName",
          "sourceType", "reliabilityLevel", "checkedAt", "evidence",
          "stale", "conflicted", "refreshFailed"
        ],
        "properties": {
          "factId": {"type": "string", "minLength": 1, "maxLength": 80},
          "category": {"type": "string", "minLength": 1, "maxLength": 60},
          "date": {"type": "string", "format": "date"},
          "effect": {"type": "string", "minLength": 1, "maxLength": 60},
          "targetPoiId": {"type": "string", "minLength": 1, "maxLength": 100},
          "targetName": {"type": "string", "minLength": 1, "maxLength": 120},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "sourceName": {"type": "string", "minLength": 1, "maxLength": 120},
          "sourceType": {"type": "string", "minLength": 1, "maxLength": 60},
          "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "reliabilityLevel": {
            "type": "string", "minLength": 1, "maxLength": 60
          },
          "checkedAt": {"type": "string", "format": "date-time"},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
          "stale": {"type": "boolean"},
          "conflicted": {"type": "boolean"},
          "refreshFailed": {"type": "boolean"}
        }
      }
    },
    "knowledgeEvidence": {
      "oneOf": [
        {"$ref": "#/$defs/realKnowledgeEvidence"},
        {"$ref": "#/$defs/demoKnowledgeEvidence"},
        {"$ref": "#/$defs/unavailableKnowledgeEvidence"}
      ]
    },
    "realKnowledgeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "query", "citations", "freshness"],
      "properties": {
        "status": {"const": "REAL"},
        "query": {"type": "string", "minLength": 1, "maxLength": 200},
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/knowledgeCitation"}
        },
        "freshness": {"$ref": "#/$defs/availableFreshness"}
      }
    },
    "demoKnowledgeEvidence": {
      "$ref": "#/$defs/nonRealKnowledgeEvidence",
      "unevaluatedProperties": false,
      "properties": {"status": {"const": "DEMO"}}
    },
    "unavailableKnowledgeEvidence": {
      "$ref": "#/$defs/nonRealKnowledgeEvidence",
      "unevaluatedProperties": false,
      "properties": {"status": {"const": "UNAVAILABLE"}}
    },
    "nonRealKnowledgeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "query", "citations", "freshness", "message"],
      "properties": {
        "status": {"enum": ["DEMO", "UNAVAILABLE"]},
        "query": {"type": "string", "minLength": 1, "maxLength": 200},
        "citations": {"type": "array", "maxItems": 0},
        "freshness": {"$ref": "#/$defs/unavailableFreshness"},
        "message": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "knowledgeCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId", "documentVersion", "chunkId", "chunkIndex", "title",
        "sourceUrl", "sourceName", "collectedAt", "reliabilityLevel", "similarity"
      ],
      "properties": {
        "documentId": {"type": "string", "minLength": 1, "maxLength": 200},
        "documentVersion": {"type": "integer", "minimum": 1},
        "chunkId": {"type": "string", "minLength": 1, "maxLength": 200},
        "chunkIndex": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "sourceName": {"type": "string", "minLength": 1, "maxLength": 120},
        "collectedAt": {"type": "string", "format": "date-time"},
        "reliabilityLevel": {"type": "string", "minLength": 1, "maxLength": 60},
        "similarity": {"type": "number", "minimum": -1, "maximum": 1}
      }
    },
    "availableFreshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checkedAt"],
          "properties": {
            "status": {"const": "FRESH"},
            "checkedAt": {"type": "string", "format": "date-time"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checkedAt"],
          "properties": {
            "status": {"const": "STALE"},
            "checkedAt": {"type": "string", "format": "date-time"},
            "staleReason": {"type": "string", "minLength": 1, "maxLength": 60}
          }
        }
      ]
    },
    "unavailableFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"const": "UNAVAILABLE"}}
    },
    "amapItinerary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "days", "estimatedTotalCost"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/amapDay"}},
        "estimatedTotalCost": {"$ref": "#/$defs/money"}
      }
    },
    "demoItinerary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "days", "estimatedTotalCost"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/demoDay"}},
        "estimatedTotalCost": {"$ref": "#/$defs/money"}
      }
    },
    "amapDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "activities", "transitLegs"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/amapActivity"}},
        "transitLegs": {"$ref": "#/$defs/transitLegs"}
      }
    },
    "demoDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "activities", "transitLegs"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "activities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/demoActivity"}},
        "transitLegs": {"$ref": "#/$defs/transitLegs"}
      }
    },
    "transitLegs": {
      "type": "array",
      "maxItems": 999,
      "items": {"$ref": "#/$defs/transitLeg"}
    },
    "transitLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromActivityIndex", "toActivityIndex", "mode", "distanceMeters",
        "durationSeconds", "provider", "estimated", "polyline"
      ],
      "properties": {
        "transitId": {"type": "string", "format": "uuid"},
        "fromActivityIndex": {"type": "integer", "minimum": 0},
        "toActivityIndex": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["WALKING", "DRIVING"]},
        "distanceMeters": {"type": "integer", "minimum": 0, "maximum": 40100000},
        "durationSeconds": {"type": "integer", "minimum": 0, "maximum": 31536000},
        "provider": {"enum": ["AMAP", "DEMO"]},
        "estimated": {"type": "boolean"},
        "polyline": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/$defs/coordinates"}}
      },
      "allOf": [
        {"if": {"properties": {"provider": {"const": "AMAP"}}}, "then": {"properties": {"estimated": {"const": false}}}},
        {"if": {"properties": {"provider": {"const": "DEMO"}}}, "then": {"properties": {"estimated": {"const": true}}}}
      ]
    },
    "amapActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "startTime", "endTime", "estimatedCost", "source", "providerPoiId", "coordinates", "address"],
      "properties": {
        "activityId": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "estimatedCost": {"$ref": "#/$defs/money"},
        "source": {"const": "AMAP"},
        "providerPoiId": {"type": "string", "minLength": 1, "maxLength": 100},
        "coordinates": {"$ref": "#/$defs/coordinates"},
        "address": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "demoActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "startTime", "endTime", "estimatedCost", "source"],
      "properties": {
        "activityId": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"},
        "estimatedCost": {"$ref": "#/$defs/money"},
        "source": {"const": "DEMO"}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "providerProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedProviderMode", "primaryProvider", "actualProviders",
        "fallbackAttempted", "fallbackSucceeded", "fallbackOperations"
      ],
      "properties": {
        "requestedProviderMode": {
          "enum": ["DEMO_ONLY", "REAL_ONLY", "REAL_WITH_EXPLICIT_FALLBACK"]
        },
        "primaryProvider": {"enum": ["AMAP", "DEMO"]},
        "actualProviders": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["AMAP", "DEMO"]}
        },
        "fallbackAttempted": {"type": "boolean"},
        "fallbackSucceeded": {"type": "boolean"},
        "fallbackReason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[A-Z0-9_]+$"
        },
        "fallbackOperations": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fallbackOperation"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"fallbackAttempted": {"const": false}}},
          "then": {
            "properties": {
              "fallbackSucceeded": {"const": false},
              "fallbackReason": {"type": "null"},
              "fallbackOperations": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"fallbackSucceeded": {"const": true}}},
          "then": {
            "required": ["fallbackReason"],
            "properties": {
              "fallbackAttempted": {"const": true},
              "fallbackReason": {"type": "string"},
              "fallbackOperations": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"requestedProviderMode": {"const": "DEMO_ONLY"}}},
          "then": {
            "properties": {
              "primaryProvider": {"const": "DEMO"},
              "actualProviders": {
                "minItems": 1, "maxItems": 1, "items": {"const": "DEMO"}
              },
              "fallbackAttempted": {"const": false},
              "fallbackSucceeded": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"requestedProviderMode": {"const": "REAL_ONLY"}}},
          "then": {
            "properties": {
              "primaryProvider": {"const": "AMAP"},
              "actualProviders": {
                "minItems": 1, "maxItems": 1, "items": {"const": "AMAP"}
              },
              "fallbackAttempted": {"const": false},
              "fallbackSucceeded": {"const": false}
            }
          }
        },
        {
          "if": {
            "properties": {
              "requestedProviderMode": {"const": "REAL_WITH_EXPLICIT_FALLBACK"},
              "fallbackAttempted": {"const": false}
            },
            "required": ["requestedProviderMode", "fallbackAttempted"]
          },
          "then": {
            "properties": {
              "primaryProvider": {"const": "AMAP"},
              "actualProviders": {
                "minItems": 1, "maxItems": 1, "items": {"const": "AMAP"}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requestedProviderMode": {"const": "REAL_WITH_EXPLICIT_FALLBACK"},
              "fallbackAttempted": {"const": true}
            },
            "required": ["requestedProviderMode", "fallbackAttempted"]
          },
          "then": {
            "properties": {
              "primaryProvider": {"const": "AMAP"},
              "actualProviders": {"contains": {"const": "DEMO"}}
            }
          }
        }
      ]
    },
    "fallbackOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation", "transitId", "fromActivityId", "toActivityId",
        "requestedMode", "actualProvider", "errorCategory", "errorCode", "retryCount"
      ],
      "properties": {
        "operation": {"enum": ["PLANNING", "REPLANNING", "ROUTE"]},
        "transitId": {"type": ["string", "null"], "format": "uuid"},
        "fromActivityId": {"type": ["string", "null"], "format": "uuid"},
        "toActivityId": {"type": ["string", "null"], "format": "uuid"},
        "requestedMode": {"const": "REAL_WITH_EXPLICIT_FALLBACK"},
        "actualProvider": {"const": "DEMO"},
        "errorCategory": {
          "enum": [
            "QUOTA_EXCEEDED", "RATE_LIMITED", "TIMEOUT", "NETWORK_ERROR",
            "PROVIDER_UNAVAILABLE", "MALFORMED_RESPONSE"
          ]
        },
        "errorCode": {
          "type": "string", "minLength": 1, "maxLength": 60,
          "pattern": "^[A-Z0-9_]+$"
        },
        "retryCount": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "ROUTE"}}},
          "then": {
            "properties": {
              "transitId": {"type": "string", "format": "uuid"},
              "fromActivityId": {"type": "string", "format": "uuid"},
              "toActivityId": {"type": "string", "format": "uuid"}
            }
          },
          "else": {
            "properties": {
              "transitId": {"type": "null"},
              "fromActivityId": {"type": "null"},
              "toActivityId": {"type": "null"}
            }
          }
        }
      ]
    },
    "money": {"type": "number", "minimum": 0, "maximum": 9999999999.99, "multipleOf": 0.01}
  }
}
