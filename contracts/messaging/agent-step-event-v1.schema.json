{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/agent-step-event-v1.schema.json",
  "title": "Agent Step Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "schemaVersion",
    "eventId",
    "traceId",
    "tripId",
    "runId",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "eventType": {"const": "AGENT_STEP"},
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "errorCode": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 60
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "tool", "ok", "summary"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "tool": {"$ref": "#/$defs/tool"},
        "ok": {"type": "boolean"},
        "summary": {"$ref": "#/$defs/summary"},
        "errorCode": {"$ref": "#/$defs/errorCode"}
      }
    }
  }
}
