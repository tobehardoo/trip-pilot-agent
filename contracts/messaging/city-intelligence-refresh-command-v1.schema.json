{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippilot.local/contracts/city-intelligence-refresh-command-v1.schema.json",
  "title": "City Intelligence Refresh Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType", "schemaVersion", "eventId", "refreshId", "tripId",
    "occurredAt", "payload"
  ],
  "properties": {
    "eventType": {"const": "CITY_INTELLIGENCE_REFRESH_REQUESTED"},
    "schemaVersion": {"const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "refreshId": {"type": "string", "format": "uuid"},
    "tripId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city", "cityCode", "startDate", "endDate", "sourceIds",
        "requiredCategories", "idempotencyKey"
      ],
      "properties": {
        "city": {"type": "string", "minLength": 1, "maxLength": 120},
        "cityCode": {"type": "string", "pattern": "^[A-Z0-9-]{2,32}$"},
        "startDate": {"type": "string", "format": "date"},
        "endDate": {"type": "string", "format": "date"},
        "sourceIds": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "format": "uuid"}
        },
        "requiredCategories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "enum": [
              "CURRENT_WEATHER", "DAILY_FORECAST", "ATTRACTION_DETAILS",
              "OPENING_HOURS", "TICKET_PRICE", "RESERVATION_REQUIREMENT",
              "TEMPORARY_CLOSURE"
            ]
          }
        },
        "idempotencyKey": {"type": "string", "format": "uuid"}
      }
    }
  }
}
