    "placeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "providerPoiId", "name", "address", "province", "city",
        "district", "longitude", "latitude"
      ],
      "properties": {
        "provider": {"enum": ["AMAP", "DEMO"]},
        "providerPoiId": {"type": "string", "minLength": 1, "maxLength": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "address": {"type": "string", "maxLength": 200},
        "province": {"type": "string", "maxLength": 80},
        "city": {"type": "string", "maxLength": 80},
        "district": {"type": "string", "maxLength": 80},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "fixedSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeName", "startTime", "endTime"],
      "properties": {
        "placeName": {"type": "string", "minLength": 1, "maxLength": 120},
        "startTime": {"type": "string", "format": "date-time"},
        "endTime": {"type": "string", "format": "date-time"}
      }
    },
    "travelAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeName", "time"],
      "properties": {
        "placeName": {"type": "string", "minLength": 1, "maxLength": 120},
        "time": {"type": "string", "format": "date-time"},
        "placeRef": {"$ref": "#/$defs/placeRef"}
      }
    },
    "placeAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeName"],
      "properties": {
        "placeName": {"type": "string", "minLength": 1, "maxLength": 120},
        "placeRef": {"$ref": "#/$defs/placeRef"}
      }
    },
    "mealWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mealType", "startTime", "endTime"],
      "properties": {
        "mealType": {"enum": ["BREAKFAST", "LUNCH", "DINNER"]},
        "startTime": {"type": "string"},
        "endTime": {"type": "string"},
        "source": {"enum": ["DEFAULT", "USER", "DISABLED"]}
      }
    },
    "guideEvidence": {
      "type": "object",
      "additionalProperties": false,
